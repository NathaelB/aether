  "query": "\n            SELECT d.id AS deployment_id, d.organisation_id, o.plan\n            FROM deployments d\n            JOIN organisations o ON o.id = d.organisation_id\n            WHERE d.kind = $1\n              AND d.deleted_at IS NULL\n            ",
