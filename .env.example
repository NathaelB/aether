# === Database Configuration ===
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=aether
DATABASE_USER=aether
DATABASE_PASSWORD=aether

# === Authentication Configuration (Ferriskey) ===
AUTH_ISSUER=http://localhost:3334/realms/aether

# === Server Configuration ===
SERVER_HOST=0.0.0.0
SERVER_PORT=7777

# === Logging Configuration ===
LOG_FILTER=info
LOG_JSON=false

# === CORS Configuration ===
ALLOWED_ORIGINS=http://localhost:5173

# How many seconds a data plane may go without its Herald reporting before the
# control plane stops selecting it for new deployments. A small multiple of
# Herald's poll interval: one missed cycle is a blip, three is a cluster
# that is gone.
DATAPLANE_HEARTBEAT_WINDOW_SECONDS=90

# Region used when a deployment request does not name one. A requested region is
# always honoured; this only fills in a missing one.
DEFAULT_REGION=local

# How Herald authenticates to the control plane. Prefer client credentials: the
# control plane checks token expiry, so a fixed CONTROL_PLANE_TOKEN stops
# working with no way for Herald to recover.
AUTH_CLIENT_ID=herald-service
# AUTH_CLIENT_SECRET=
