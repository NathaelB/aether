# === Database Configuration ===
DATABASE_HOST=localhost
DATABASE_PORT=5433

# Used by host-side tooling only -- `cargo sqlx prepare` and the integration
# tests under `libs/aether-postgres/tests/`. The port must match the one
# docker-compose publishes (AETHER_POSTGRES_PORT, 5433 by default); 5432 is
# very likely another project's database, and connecting to it fails
# authentication rather than saying so.
DATABASE_URL=postgres://aether:aether@localhost:5433/aether
DATABASE_NAME=aether
DATABASE_USER=aether
DATABASE_PASSWORD=aether

# === Authentication Configuration (Ferriskey) ===
AUTH_ISSUER=http://localhost:3334/realms/aether

# === Server Configuration ===
SERVER_HOST=0.0.0.0
SERVER_PORT=7777

# === Logging Configuration ===
LOG_FILTER=info
LOG_JSON=false

# === CORS Configuration ===
ALLOWED_ORIGINS=http://localhost:5173

# How many seconds a data plane may go without its Herald reporting before the
# control plane stops selecting it for new deployments. A small multiple of
# Herald's poll interval: one missed cycle is a blip, three is a cluster
# that is gone.
DATAPLANE_HEARTBEAT_WINDOW_SECONDS=90

# Region used when a deployment request does not name one. A requested region is
# always honoured; this only fills in a missing one.
DEFAULT_REGION=local

# How Herald authenticates to the control plane. Prefer client credentials: the
# control plane checks token expiry, so a fixed CONTROL_PLANE_TOKEN stops
# working with no way for Herald to recover.
AUTH_CLIENT_ID=herald-service
# AUTH_CLIENT_SECRET=

# === Object storage ===
# Where archives go. The defaults match the RustFS in docker-compose, which
# publishes 9800 on the host: 9000 is the port every object store in every
# other project also picks, and one answering there is very likely not this
# one.
OBJECT_STORE_ENDPOINT=http://localhost:9800
OBJECT_STORE_BUCKET=aether-backups
OBJECT_STORE_ACCESS_KEY=aether
OBJECT_STORE_SECRET_KEY=aetheraether

# host/bucket rather than bucket.host. True for every self hosted store; AWS
# wants it false. Getting it wrong produces a DNS failure naming the bucket,
# which reads like a permissions problem and is not one.
OBJECT_STORE_PATH_STYLE=true

# Signed into every request. Self hosted stores mostly ignore which region it
# is and mind very much that there is one.
OBJECT_STORE_REGION=us-east-1
